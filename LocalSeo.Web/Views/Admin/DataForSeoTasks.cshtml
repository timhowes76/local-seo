@model IReadOnlyList<DataForSeoTaskRow>
@{
    ViewData["Title"] = "DataForSEO Tasks";
    var selectedTaskType = ViewBag.TaskType as string ?? "all";
    var selectedTaskTypeKey = selectedTaskType.ToLowerInvariant();
    var selectedStatus = ViewBag.TaskStatus as string ?? "all";
    var selectedStatusKey = selectedStatus.ToLowerInvariant();
    var statusMessage = TempData["Status"] as string;
    string TrimEndpoint(string? value, int maxLength)
    {
        var trimmed = (value ?? string.Empty).Trim();
        if (trimmed.Length == 0)
            return "N/A";

        return trimmed.Length <= maxLength
            ? trimmed
            : $"{trimmed[..maxLength]}...";
    }
}

<div class="page-stack">
    <style>
        .dataforseo-task-filters.inline-filter-line {
            display: flex;
            flex-wrap: nowrap;
            align-items: flex-end;
            gap: 10px;
        }

        .dataforseo-task-filters .form-row {
            display: grid;
            gap: 6px;
            min-width: 0;
            flex: 0 0 auto;
        }

        .dataforseo-task-filters .form-row select {
            width: auto !important;
            max-width: none !important;
            min-width: 0 !important;
        }

        .dataforseo-task-filters .inline-filter-actions {
            flex: 0 0 auto;
            align-self: end;
        }

        .dataforseo-task-message-row td {
            padding-top: 0;
            border-top: 0;
        }

        .dataforseo-task-message {
            display: block;
            white-space: normal;
            color: var(--muted);
            font-size: .95rem;
            line-height: 1.4;
            padding: .2rem 0 .35rem;
        }

        .dataforseo-task-message-empty {
            color: var(--muted);
            font-style: italic;
        }
    </style>
    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="notice">@statusMessage</div>
    }

    <section class="card">
        <div class="toolbar">
            <a href="/admin/logs" class="btn btn-secondary">Back to Logs</a>
        </div>

        <form method="get" action="/admin/logs/dataforseo-tasks" class="inline-filter-line dataforseo-task-filters">
            <div class="form-row">
                <label for="taskTypeFilter">Task Type</label>
                <select id="taskTypeFilter" name="taskType">
                    @if (selectedTaskTypeKey == "all")
                    {
                        <option value="all" selected>All</option>
                    }
                    else
                    {
                        <option value="all">All</option>
                    }
                    @if (selectedTaskTypeKey == "my_business_info")
                    {
                        <option value="my_business_info" selected>my_business_info</option>
                    }
                    else
                    {
                        <option value="my_business_info">my_business_info</option>
                    }
                    @if (selectedTaskTypeKey == "my_business_updates")
                    {
                        <option value="my_business_updates" selected>my_business_updates</option>
                    }
                    else
                    {
                        <option value="my_business_updates">my_business_updates</option>
                    }
                    @if (selectedTaskTypeKey == "reviews")
                    {
                        <option value="reviews" selected>reviews</option>
                    }
                    else
                    {
                        <option value="reviews">reviews</option>
                    }
                    @if (selectedTaskTypeKey == "questions_and_answers")
                    {
                        <option value="questions_and_answers" selected>questions_and_answers</option>
                    }
                    else
                    {
                        <option value="questions_and_answers">questions_and_answers</option>
                    }
                    @if (selectedTaskTypeKey == "social_profiles")
                    {
                        <option value="social_profiles" selected>social_profiles</option>
                    }
                    else
                    {
                        <option value="social_profiles">social_profiles</option>
                    }
                    @if (selectedTaskTypeKey == "apple_bing")
                    {
                        <option value="apple_bing" selected>apple_bing</option>
                    }
                    else
                    {
                        <option value="apple_bing">apple_bing</option>
                    }
                </select>
            </div>

            <div class="form-row">
                <label for="statusFilter">Status</label>
                <select id="statusFilter" name="status">
                    @if (selectedStatusKey == "all")
                    {
                        <option value="all" selected>All</option>
                    }
                    else
                    {
                        <option value="all">All</option>
                    }
                    @if (selectedStatusKey == "created")
                    {
                        <option value="Created" selected>Created</option>
                    }
                    else
                    {
                        <option value="Created">Created</option>
                    }
                    @if (selectedStatusKey == "pending")
                    {
                        <option value="Pending" selected>Pending</option>
                    }
                    else
                    {
                        <option value="Pending">Pending</option>
                    }
                    @if (selectedStatusKey == "ready")
                    {
                        <option value="Ready" selected>Ready</option>
                    }
                    else
                    {
                        <option value="Ready">Ready</option>
                    }
                    @if (selectedStatusKey == "populated")
                    {
                        <option value="Populated" selected>Populated</option>
                    }
                    else
                    {
                        <option value="Populated">Populated</option>
                    }
                    @if (selectedStatusKey == "nodata")
                    {
                        <option value="NoData" selected>NoData</option>
                    }
                    else
                    {
                        <option value="NoData">NoData</option>
                    }
                    @if (selectedStatusKey == "completednodata")
                    {
                        <option value="CompletedNoData" selected>CompletedNoData</option>
                    }
                    else
                    {
                        <option value="CompletedNoData">CompletedNoData</option>
                    }
                    @if (selectedStatusKey == "completednoreviews")
                    {
                        <option value="CompletedNoReviews" selected>CompletedNoReviews</option>
                    }
                    else
                    {
                        <option value="CompletedNoReviews">CompletedNoReviews</option>
                    }
                    @if (selectedStatusKey == "completednoupdates")
                    {
                        <option value="CompletedNoUpdates" selected>CompletedNoUpdates</option>
                    }
                    else
                    {
                        <option value="CompletedNoUpdates">CompletedNoUpdates</option>
                    }
                    @if (selectedStatusKey == "error")
                    {
                        <option value="Error" selected>Error</option>
                    }
                    else
                    {
                        <option value="Error">Error</option>
                    }
                </select>
            </div>

            <div class="form-row inline-filter-actions">
                <button type="submit" class="btn btn-secondary">Apply Filter</button>
            </div>
        </form>

        <div class="toolbar">
            <form method="post" action="/admin/logs/dataforseo-tasks/refresh?taskType=@Uri.EscapeDataString(selectedTaskType)&status=@Uri.EscapeDataString(selectedStatus)">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-secondary">Refresh Statuses</button>
            </form>
            <form method="post" action="/admin/logs/dataforseo-tasks/populate-ready?taskType=@Uri.EscapeDataString(selectedTaskType)&status=@Uri.EscapeDataString(selectedStatus)" onsubmit="return confirm('Populate results for all Ready tasks in the current filter?');">
                @Html.AntiForgeryToken()
                <button type="submit">Populate All Ready</button>
            </form>
            <form method="post" action="/admin/logs/dataforseo-tasks/delete-errors?taskType=@Uri.EscapeDataString(selectedTaskType)&status=@Uri.EscapeDataString(selectedStatus)" onsubmit="return confirm('Delete all Error rows for the current filter?');">
                @Html.AntiForgeryToken()
                <button type="submit">Delete Error Rows</button>
            </form>
        </div>
    </section>

    <section class="card">
        <h2 class="card-title">Task List</h2>
        @if (Model.Count == 0)
        {
            <p class="muted">No DataForSEO tasks found.</p>
        }
        else
        {
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Task Type</th>
                            <th>Place ID</th>
                            <th>Status</th>
                            <th>Task Code</th>
                            <th>Endpoint</th>
                            <th>Created</th>
                            <th>Last Checked</th>
                            <th>Ready</th>
                            <th>Populated</th>
                            <th>Last Import Count</th>
                            <th>Error</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var row in Model)
                    {
                        var statusText = string.Equals(row.Status, "NoData", StringComparison.OrdinalIgnoreCase)
                            ? "No Data"
                            : row.Status;
                        var statusClass = row.Status.ToLowerInvariant() switch
                        {
                            "ready" => "status-ready",
                            "error" => "status-error",
                            "nodata" => "status-nodata",
                            "pending" => "status-pending",
                            "created" => "status-pending",
                            "populated" => "status-healthy",
                            _ => "status-noreviews"
                        };
                        <tr>
                            <td rowspan="2"><a href="/admin/logs/dataforseo-tasks/@row.DataForSeoReviewTaskId?taskType=@Uri.EscapeDataString(selectedTaskType)&status=@Uri.EscapeDataString(selectedStatus)"><code>@row.DataForSeoReviewTaskId</code></a></td>
                            <td>@row.TaskType</td>
                            <td><code>@row.PlaceId</code></td>
                            <td><span class="status-pill @statusClass">@statusText</span></td>
                            <td rowspan="2">@(row.TaskStatusCode?.ToString() ?? "N/A")</td>
                            <td rowspan="2" title="@(string.IsNullOrWhiteSpace(row.Endpoint) ? null : row.Endpoint)">@TrimEndpoint(row.Endpoint, 20)</td>
                            <td rowspan="2">@row.CreatedAtUtc.ToString("dd MMM yyyy HH:mm")</td>
                            <td rowspan="2">@(row.LastCheckedUtc?.ToString("dd MMM yyyy HH:mm") ?? "N/A")</td>
                            <td rowspan="2">@(row.ReadyAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "N/A")</td>
                            <td rowspan="2">@(row.PopulatedAtUtc?.ToString("dd MMM yyyy HH:mm") ?? "N/A")</td>
                            <td rowspan="2">@(row.LastPopulateReviewCount?.ToString() ?? "N/A")</td>
                            <td rowspan="2">@(row.LastError ?? "N/A")</td>
                            <td rowspan="2">
                                @if (string.Equals(row.Status, "Ready", StringComparison.OrdinalIgnoreCase))
                                {
                                    <form method="post" action="/admin/logs/dataforseo-tasks/@row.DataForSeoReviewTaskId/populate?taskType=@selectedTaskType&status=@selectedStatus">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-secondary">Populate Results</button>
                                    </form>
                                }
                            </td>
                        </tr>
                        <tr class="dataforseo-task-message-row">
                            <td colspan="3">
                                @if (string.IsNullOrWhiteSpace(row.TaskStatusMessage))
                                {
                                    <span class="dataforseo-task-message dataforseo-task-message-empty">No task message.</span>
                                }
                                else
                                {
                                    <span class="dataforseo-task-message">@row.TaskStatusMessage</span>
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<script>
    (() => {
        const selects = document.querySelectorAll(".dataforseo-task-filters select");
        if (!selects.length) return;

        const canvas = document.createElement("canvas");
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        selects.forEach((select) => {
            const computed = window.getComputedStyle(select);
            ctx.font = computed.font || `${computed.fontSize} ${computed.fontFamily}`;

            let max = 0;
            Array.from(select.options).forEach((option) => {
                const width = ctx.measureText(option.textContent || "").width;
                if (width > max) max = width;
            });

            // Include select horizontal padding and dropdown arrow space.
            const horizontalPadding =
                (parseFloat(computed.paddingLeft) || 0) +
                (parseFloat(computed.paddingRight) || 0) +
                34;

            select.style.width = `${Math.ceil(max + horizontalPadding)}px`;
        });
    })();
</script>

