@model LoginRequestModel
@{
    ViewData["Title"] = "Sales Local SEO Login";
    var message = (string?)ViewBag.Message;
    var brandLogoPath = string.Equals(Context.Request.Cookies["theme"], "dark=1", StringComparison.Ordinal)
        ? "/assets/images/dark-logo.svg"
        : "/assets/images/logo.svg";
}
<div class="login-card card">
    <div class="login-brand">
        <img class="login-brand-logo" src="@brandLogoPath" alt="Kontrolit" />
        <h2 class="card-title">Local SEO Login</h2>
    </div>

    @if (!string.IsNullOrWhiteSpace(message))
    {
        <div class="notice">@message</div>
    }

    <p class="muted">Sign in with your email and password.</p>
    <form method="post" action="/login" class="form-grid">
        @Html.AntiForgeryToken()
        <div class="form-row">
            <label for="email-input">Email</label>
            <input id="email-input" name="Email" type="email" value="@Model.Email" autocomplete="email" required />
        </div>
        <div class="form-row">
            <label for="password-input">Password</label>
            @await Html.PartialAsync("_PasswordInput", new PasswordInputModel
            {
                Id = "password-input",
                Name = "Password",
                Autocomplete = "current-password",
                Required = true
            })
        </div>
        <div class="form-row">
            <label class="checkbox-inline" for="trust-device-input">
                <input id="trust-device-input" name="TrustThisDevice" type="checkbox" value="true" @(Model.TrustThisDevice ? "checked" : null) />
                <span>Trust this device</span>
            </label>
            <input type="hidden" name="TrustThisDevice" value="false" />
            <p class="form-help">Keeps you signed in for 30 days. Don't use on shared devices.</p>
        </div>
        <div class="login-actions">
            <button type="submit">Continue</button>
        </div>
    </form>
    <p class="muted">
        <a href="/forgot-password">Forgot password?</a>
    </p>
</div>
